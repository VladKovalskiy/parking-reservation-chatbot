# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001

# --- Embeddings ---
# local | voyage | fake
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
# VOYAGE_API_KEY=

# --- Vector store ---
# Milvus Lite (dev):        ./data/milvus_lite.db
# Milvus standalone (demo): http://localhost:19530
MILVUS_URI=./data/milvus_lite.db
MILVUS_COLLECTION=parking_static

# --- Dynamic data ---
DATABASE_URL=postgresql+psycopg://parking:parking@localhost:5432/parking

# --- Retrieval ---
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Guardrails ---
PII_ENABLED=true
PII_SCORE_THRESHOLD=0.5
